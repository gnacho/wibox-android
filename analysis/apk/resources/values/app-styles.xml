<?xml version='1.0' encoding='utf-8'?>
<resources><style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:buttonStyle">@style/CustomButton</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    </style>
    <style name="AppTheme.Launcher" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/start</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="CustomButton" parent="">
        <item name="android:textSize">@dimen/text_normal_size</item>
        <item name="android:textStyle">0x0</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:gravity">0x11</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="CustomDialog" parent="@style/Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="colorAccent">@color/progressBarBg</item>
    </style>
    <style name="CustomDialogTheme" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowSoftInputMode">0x20</item>
    </style>
    <style name="CustomEdit" parent="">
        <item name="android:background">@null</item>
        <item name="android:layoutDirection">3</item>
    </style>
    <style name="CustomLockButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:alpha">1</item>
    </style>
    <style name="CustomTextView" parent="">
        <item name="android:textSize">@dimen/text_small_size</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textDirection">5</item>
        <item name="android:textAlignment">5</item>
    </style>
    <style name="Custom_Text_View_Marquee" parent="">
        <item name="android:textColor">@color/textColor</item>
        <item name="android:ellipsize">4</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:marqueeRepeatLimit">-1</item>
    </style>
    <style name="LoadingBackground" parent="">
        <item name="android:background">@drawable/start</item>
    </style>
    <style name="MyDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="PreviewMiddleButton" parent="">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="PreviewMiddleCutLine" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">-1</item>
    </style>
    <style name="TextAppearance.Compat.Notification.Info" parent="@android:style/TextAppearance.Material.Notification.Info">
    </style>
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title">
    </style>
    <style name="addEtStyle" parent="">
        <item name="android:textSize">@dimen/text_normal_size</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">#ffffff</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">43dp</item>
    </style>
    <style name="custom_dialog2" parent="@android:style/Theme.Dialog">
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="new_device_setup_content" parent="@style/new_device_setup_title">
        <item name="android:textSize">@dimen/text_small_size</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:gravity">0x1</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_marginLeft">@dimen/standard_width</item>
        <item name="android:layout_marginTop">@dimen/margin_large</item>
        <item name="android:layout_marginRight">@dimen/standard_width</item>
    </style>
    <style name="new_device_setup_title" parent="">
        <item name="android:textSize">@dimen/text_normal_size</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:gravity">0x1</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_marginLeft">@dimen/standard_width</item>
        <item name="android:layout_marginTop">40dp</item>
        <item name="android:layout_marginRight">@dimen/standard_width</item>
    </style>
    <style name="option_button" parent="">
        <item name="android:background">@drawable/publico_selector_btn_bg</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:layout_marginStart">30dp</item>
        <item name="android:layout_marginEnd">30dp</item>
    </style>
    <style name="option_button2" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">0x11</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:minWidth">@dimen/btn_width</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>
    <style name="option_button_small" parent="@style/option_button2">
        <item name="android:minWidth">1dp</item>
        <item name="android:minHeight">35dp</item>
        <item name="android:width">@dimen/btn_small_width</item>
    </style>
    <style name="option_linear_layout" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/publico_selector_btn_bg</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="option_style" parent="">
        <item name="android:gravity">0x11</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">@dimen/padding_normal</item>
        <item name="android:paddingTop">@dimen/padding_mini</item>
        <item name="android:paddingRight">@dimen/padding_small</item>
        <item name="android:paddingBottom">@dimen/padding_mini</item>
        <item name="android:layout_width">-1</item>
    </style>
    <style name="option_text" parent="@style/CustomTextView">
        <item name="android:gravity">0x10</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">-1</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAlignment">2</item>
    </style>
    <style name="option_text_view" parent="@style/CustomTextView">
        <item name="android:textSize">@dimen/text_normal_size</item>
        <item name="android:gravity">0x10</item>
        <item name="android:background">@drawable/publico_selector_btn_bg</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableEnd">@drawable/icon_arrow_list_right</item>
        <item name="android:textAlignment">2</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
    <style name="rlStyle" parent="">
        <item name="android:background">@color/device_list_pressed</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_marginLeft">10dp</item>
    </style>
    <style name="unlock_dialog" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:scaleType">5</item>
    </style>
</resources>