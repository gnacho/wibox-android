<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_item"
    android:background="@drawable/preview_shape_item_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_item_play"
        android:visibility="gone"
        android:layout_width="@dimen/preview_item_icon_small"
        android:layout_height="@dimen/preview_item_icon_small"
        android:src="@drawable/selector_window_btn_play"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_item_add"
        android:layout_width="@dimen/preview_item_icon_small"
        android:layout_height="@dimen/preview_item_icon_small"
        android:src="@drawable/selector_window_btn_add"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_item_refresh"
        android:visibility="gone"
        android:layout_width="@dimen/preview_item_icon_small"
        android:layout_height="@dimen/preview_item_icon_small"
        android:src="@drawable/selector_window_btn_refresh"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressbar"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="1"/>
    <TextView
        android:textColor="@color/white"
        android:layout_gravity="start|bottom"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="5dp"/>
    <TextView
        android:textColor="@color/white"
        android:layout_gravity="end|bottom"
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="20px"/>
</FrameLayout>
