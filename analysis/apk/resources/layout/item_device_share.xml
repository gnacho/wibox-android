<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_background"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:paddingStart="10dp"
                android:paddingEnd="3dp">
                <TextView
                    android:textSize="18sp"
                    android:gravity="bottom"
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="name"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"
                    style="@style/CustomTextView"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/textColorGray"
                    android:id="@+id/tv_code"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_weight="1"
                    style="@style/CustomTextView"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_open"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:src="@drawable/selector_open_small"
                android:layout_marginStart="3dp"
                style="@style/CustomTextView"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_status"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:src="@drawable/icon_status_3"
                style="@style/CustomTextView"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="3"/>
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:src="@drawable/selector_close_small"/>
        </LinearLayout>
        <View
            android:background="@color/cut_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingStart="20dp"
            android:paddingEnd="0dp">
            <ImageView
                android:id="@+id/iv_icon_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_preview_light"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_icon_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_alarm_light"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_icon_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_call_guard_light"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_icon_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_f1_light"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_icon_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_unlock_light"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_edit"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:src="@drawable/selector_edit_small"
                android:layout_marginStart="20dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
