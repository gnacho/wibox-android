<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp">
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gl_background"
        android:background="@color/white"
        android:padding="20dp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:columnCount="2"
        app:useDefaultMargins="true">
        <EditText
            android:id="@+id/et_name"
            android:background="@drawable/publico_shape_rectangle_2"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Share1"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="20"
            app:layout_columnSpan="2"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/key_preview"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_preview_light"
            android:layout_marginEnd="5dp"
            app:layout_columnWeight="1"
            app:layout_gravity="center_vertical"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_preview"
            android:padding="3dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_check_small"
            android:scaleType="centerCrop"
            app:layout_gravity="fill_vertical"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_alarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_alarm"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_alarm_light"
            android:layout_marginEnd="5dp"
            app:layout_columnWeight="1"
            app:layout_gravity="center_vertical"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_alarm"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_check_small"
            android:scaleType="centerCrop"
            app:layout_gravity="fill_vertical"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_call_guard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_guard_call"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_call_guard_light"
            android:layout_marginEnd="5dp"
            app:layout_columnWeight="1"
            app:layout_gravity="center_vertical"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_call_guard"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_check_small"
            android:scaleType="centerCrop"
            app:layout_gravity="fill_vertical"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_f1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_f1_function"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_f1_light"
            android:layout_marginEnd="5dp"
            app:layout_columnWeight="1"
            app:layout_gravity="center_vertical"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_f1"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_check_small"
            android:scaleType="centerCrop"
            app:layout_gravity="fill_vertical"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_unlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_unlock"
            android:drawablePadding="5dp"
            android:drawableStart="@drawable/icon_unlock_light"
            android:layout_marginEnd="5dp"
            app:layout_columnWeight="1"
            app:layout_gravity="center_vertical"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_unlock"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_check_small"
            android:scaleType="centerCrop"
            app:layout_gravity="fill_vertical"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/bt_save"
            android:background="@color/colorPrimary"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:text="@string/key_save"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_columnSpan="2"/>
    </androidx.gridlayout.widget.GridLayout>
</androidx.cardview.widget.CardView>
