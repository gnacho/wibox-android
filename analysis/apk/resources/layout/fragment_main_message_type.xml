<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.quvii.ubell.publico.widget.XRefreshView.XRefreshView
        android:id="@+id/xfv_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.quvii.ubell.publico.widget.stickyListHeaders.StickyListHeadersListView
                android:id="@+id/lv_alarm"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_hint"
                android:background="@color/main_ui_color_white"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:textColor="@color/textColor"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_hint_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/standard_width"
                    android:layout_marginRight="@dimen/standard_width"
                    android:text="@string/key_alarm_record_hint_motion1"
                    android:layout_marginStart="@dimen/standard_width"
                    android:layout_marginEnd="@dimen/standard_width"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/move_detection_logo"/>
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:textColor="@color/textColor"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_hint_down"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/standard_width"
                    android:text="@string/key_alarm_record_hint_motion2"
                    android:layout_marginStart="@dimen/standard_width"
                    android:layout_marginEnd="@dimen/standard_width"/>
            </LinearLayout>
        </FrameLayout>
    </com.quvii.ubell.publico.widget.XRefreshView.XRefreshView>
</FrameLayout>
