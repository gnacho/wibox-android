<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <TextView
        android:text="@string/key_product_choose_hint"
        style="@style/new_device_setup_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_type_7410"
        android:background="@drawable/publico_selector_bg_round"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="@dimen/standard_width"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginRight="@dimen/standard_width"
        android:layout_marginStart="@dimen/standard_width"
        android:layout_marginEnd="@dimen/standard_width">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_type_7410"
            android:layout_marginStart="@dimen/margin_large"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_doorbell"
            android:layout_marginStart="@dimen/margin_large"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_type_9440"
        android:background="@drawable/publico_selector_bg_round"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="@dimen/standard_width"
        android:layout_marginTop="@dimen/margin_normal"
        android:layout_marginRight="@dimen/standard_width"
        android:layout_marginStart="@dimen/standard_width"
        android:layout_marginEnd="@dimen/standard_width">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/device_type_9440"
            android:layout_marginStart="@dimen/margin_large"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_monitor"
            android:layout_marginStart="@dimen/margin_large"
            style="@style/CustomTextView"/>
    </LinearLayout>
</LinearLayout>
