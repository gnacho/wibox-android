<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <FrameLayout
        android:id="@+id/fl_window"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_centerInParent="true">
        <com.quvii.qvplayer.view.MyGLSurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="240dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_video_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/file_mangement_icon_video"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/ll_bottom_menu">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_current"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="00:00:00"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"/>
        <SeekBar
            android:id="@+id/sb_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="00:00:00"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_bottom_menu"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_menu_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_preview_play_selector"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_menu_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_preview_sound_selector"
            android:scaleType="centerInside"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
