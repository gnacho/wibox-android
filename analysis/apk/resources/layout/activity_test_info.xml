<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/publico_selector_bg_round"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Push Mode:"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_push_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GT"
            android:textAlignment="textEnd"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/publico_selector_bg_round"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="State:"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="null"
            android:textAlignment="textEnd"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_service"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service:"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_service"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="null"
            android:layout_weight="1"
            android:textAlignment="textEnd"
            android:layout_marginEnd="5dp"
            style="@style/CustomTextView"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_arrow_list_right"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Debug Mode:"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <CheckBox
            android:id="@+id/cb_debug_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_advanced"
        android:layout_marginTop="1dp"
        android:text="Advanced"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        style="@style/option_text_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_force_forwarding"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Forced forwarding:"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <CheckBox
            android:id="@+id/cb_force_forwarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_show_connect"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Show Connect Type:"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <CheckBox
            android:id="@+id/cb_show_connect_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_p2p_timeout"
        android:background="@drawable/publico_selector_btn_bg"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="P2P test timeout:"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            style="@style/CustomTextView"/>
        <TextView
            android:id="@+id/tv_p2p_timeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000ms"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_info"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="6">
        <TextView
            android:id="@+id/tv_info"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <Button
        android:id="@+id/bt_send_log"
        android:background="@drawable/publico_selector_bg_round"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="20dp"
        android:text="Send Log"
        style="@style/CustomButton"/>
</LinearLayout>
