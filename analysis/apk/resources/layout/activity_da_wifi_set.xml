<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:src="@drawable/device_add_wifi_set"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textColor="@color/bg_red"
        android:gravity="center"
        android:id="@+id/tv_net_error"
        android:padding="10dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/key_network_unavailable"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tv_status"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CustomTextView"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/bt_next"
        android:layout_marginBottom="50dp"
        android:text="@string/key_next"
        style="@style/option_button"/>
</LinearLayout>
