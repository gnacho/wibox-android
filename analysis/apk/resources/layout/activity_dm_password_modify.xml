<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <LinearLayout
        android:id="@+id/ll_old"
        style="@style/option_linear_layout">
        <TextView
            android:text="@string/key_old"
            style="@style/option_text"/>
        <EditText
            android:id="@+id/et_old_pass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/key_password_length_hint"
            android:maxLength="16"
            android:layout_weight="1"
            android:inputType="textPassword"
            style="@style/CustomEdit"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:id="@+id/tv_admin"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="2dp"
        android:text="@string/key_modify_admin_password"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        style="@style/CustomTextView"/>
    <LinearLayout
        android:id="@+id/ll_modify_new"
        style="@style/option_linear_layout">
        <TextView
            android:id="@+id/tv_new_password"
            android:text="@string/key_new"
            style="@style/option_text"/>
        <EditText
            android:id="@+id/et_new_pass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/key_password_length_hint"
            android:maxLength="16"
            android:layout_weight="1"
            android:inputType="numberPassword"
            style="@style/CustomEdit"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_modify_confirm"
        style="@style/option_linear_layout">
        <TextView
            android:id="@+id/tv_confirm_password"
            android:text="@string/key_confirm"
            style="@style/option_text"/>
        <EditText
            android:id="@+id/et_confirm_pass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/key_password_length_hint"
            android:maxLength="16"
            android:layout_weight="1"
            android:inputType="numberPassword"
            style="@style/CustomEdit"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:id="@+id/tv_unlock"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="2dp"
        android:text="@string/key_modify_unlock_password"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        style="@style/CustomTextView"/>
    <LinearLayout
        android:id="@+id/ll_modify_new_2"
        style="@style/option_linear_layout">
        <TextView
            android:id="@+id/tv_new_password_2"
            android:text="@string/key_new"
            style="@style/option_text"/>
        <EditText
            android:id="@+id/et_new_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/key_password_length_hint"
            android:maxLength="16"
            android:layout_weight="1"
            android:inputType="numberPassword"
            style="@style/CustomEdit"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_modify_confirm_2"
        style="@style/option_linear_layout">
        <TextView
            android:id="@+id/tv_confirm_password_2"
            android:text="@string/key_confirm"
            style="@style/option_text"/>
        <EditText
            android:id="@+id/et_confirm_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/key_password_length_hint"
            android:maxLength="16"
            android:layout_weight="1"
            android:inputType="numberPassword"
            style="@style/CustomEdit"/>
    </LinearLayout>
</LinearLayout>
