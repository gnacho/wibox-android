<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
    <LinearLayout style="@style/option_linear_layout">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_call_reception"
            android:layout_weight="5.3"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_sound"
        style="@style/option_linear_layout">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_sound"
            android:layout_weight="9"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_sound"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_switch_off"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_vibration"
        style="@style/option_linear_layout">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_vibration"
            android:layout_weight="9"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_vibration"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_switch_on"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_auto_rotate"
        android:visibility="gone"
        style="@style/option_linear_layout">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_auto_rotate"
            android:layout_weight="5.3"
            style="@style/CustomTextView"/>
        <ImageView
            android:id="@+id/iv_auto_rotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/btn_switch_on"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_channels_switch_mode"
        android:visibility="gone"
        style="@style/option_linear_layout">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/key_video_channel_select"
            style="@style/CustomTextView"/>
        <com.quvii.ubell.publico.util.MyMarqueeTextView
            android:textSize="@dimen/text_normal_size"
            android:textColor="@color/textColor"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_channels_select_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/key_automatic"
            android:textAlignment="textEnd"
            android:layout_marginStart="15dp"
            style="@style/Custom_Text_View_Marquee"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_preview_time"
        android:visibility="gone"
        style="@style/option_linear_layout">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/key_preview_time"
            style="@style/CustomTextView"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:textColor="@color/textColor"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_preview_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="60s"
            android:textAlignment="textEnd"
            android:layout_marginStart="15dp"
            style="@style/Custom_Text_View_Marquee"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
    <LinearLayout
        android:id="@+id/ll_about"
        style="@style/option_linear_layout">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_about"
            android:layout_weight="10"
            style="@style/CustomTextView"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/icon_arrow_list_right"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_exit"
        android:background="@drawable/publico_selector_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/key_exit"
            android:textAlignment="center"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
</LinearLayout>
