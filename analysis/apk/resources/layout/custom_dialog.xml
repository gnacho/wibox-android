<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_centerVertical="true">
    <TextView
        android:textSize="16sp"
        android:textColor="#38adff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:text="Title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/textColor"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="This is message"/>
    <FrameLayout
        android:id="@+id/my_dialog_edit_frame"
        android:layout_height="0dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        style="@style/rlStyle">
        <com.quvii.ubell.publico.view.ProhibitCopyEditText
            android:textSize="@dimen/text_normal_size"
            android:id="@+id/my_dialog_edit"
            android:background="@color/white"
            android:layout_marginBottom="1dp"
            android:hint="Edit text"
            android:maxLength="64"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            style="@style/addEtStyle"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/my_dialog_show_edit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_show_password_big"
            android:paddingStart="0dp"
            android:paddingEnd="10dp"/>
    </FrameLayout>
    <View
        android:background="#e4e4e4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/no"
            android:background="@drawable/publico_selector_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/no"
            android:maxLines="1"
            android:layout_weight="1"/>
        <View
            android:background="#e4e4e4"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/yes"
            android:background="@drawable/publico_selector_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/yes"
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
