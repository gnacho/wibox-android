<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_horizontal_operate_layout"
    android:background="@android:color/transparent"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_h_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:src="@drawable/horizontal_preview_back_selector"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_h_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/ll_horizontal_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_h_refuse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_refuse_h"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_h_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_accept_h"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_talk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_preview_full_screen_talk"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_play"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_play_selector"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_h_sound"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_mute_selector"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_video_selector"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_screenshot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_screenshot_selector"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_channel_switch_h"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_video_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/btn_preview_mode_normal_big_selecter"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_screen_size"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_screen_full_selector"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_unlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_unlock_selector"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/iv_h_f1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_full_f1_selector"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_unlock_bar"
        android:background="#293138"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@+id/ll_h_btn"
        app:layout_constraintEnd_toEndOf="@+id/ll_h_btn">
        <ImageView
            android:id="@+id/iv_h_unlock_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_bt_go_1_full_screen"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_h_unlock_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_bt_go_2_full_screen"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_h_f1_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_h_keyboard_f1"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.quvii.ubell.video.widget.PreviewHorizontalUnlockLayout
        android:id="@+id/phUnlock"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_h_btn"
        app:layout_constraintEnd_toEndOf="@+id/ll_h_btn"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
