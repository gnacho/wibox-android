<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="@dimen/margin_small"
        style="@style/option_style">
        <TextView
            android:textSize="@dimen/text_small_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_current_version"
            style="@style/CustomTextView"/>
        <TextView
            android:id="@+id/tv_current_version"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="textEnd"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="@dimen/margin_normal"
        style="@style/option_style">
        <TextView
            android:textSize="@dimen/text_small_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_latest_version"
            style="@style/CustomTextView"/>
        <TextView
            android:id="@+id/tv_latest_version"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="textEnd"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height">
        <Button
            android:gravity="center"
            android:id="@+id/bt_upgrade"
            android:background="@drawable/publico_selector_bg_round"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/key_upgrade"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
