<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/common_dialog_bg"
    android:paddingTop="@dimen/padding_normal"
    android:paddingBottom="@dimen/padding_normal"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_centerVertical="true"
    android:paddingStart="@dimen/padding_normal"
    android:paddingEnd="@dimen/padding_normal">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/grey"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:paddingTop="@dimen/padding_small_normal"
        android:paddingBottom="@dimen/padding_small_normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/key_device_manager_input_pwd"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/cl_unlock"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_icon"
            android:padding="8dp"
            android:visibility="invisible"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/login_icon_password"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:gravity="center"
            android:id="@+id/tv_show_pwd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLength="16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_show_pwd"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"/>
        <ImageView
            android:id="@+id/iv_show_pwd"
            android:padding="8dp"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/pubilco_btn_show_password"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:id="@+id/v_cut_line"
            android:background="@color/cut_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="2dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_key"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="10dp"
        android:layout_weight="4"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/tv_key1"
            android:text="1"
            app:layout_constraintBottom_toTopOf="@+id/tv_key4"
            app:layout_constraintEnd_toStartOf="@+id/tv_key2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key2"
            android:text="2"
            app:layout_constraintBottom_toTopOf="@+id/tv_key5"
            app:layout_constraintEnd_toStartOf="@+id/tv_key3"
            app:layout_constraintStart_toEndOf="@+id/tv_key1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key3"
            android:text="3"
            app:layout_constraintBottom_toTopOf="@+id/tv_key6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_key2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/unlock_dialog"/>
        <View
            android:background="@color/cut_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toTopOf="@+id/tv_key4"
            app:layout_constraintTop_toBottomOf="@+id/tv_key1"/>
        <TextView
            android:id="@+id/tv_key4"
            android:text="4"
            app:layout_constraintBottom_toTopOf="@+id/tv_key7"
            app:layout_constraintEnd_toStartOf="@+id/tv_key5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_key1"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key5"
            android:text="5"
            app:layout_constraintBottom_toTopOf="@+id/tv_key8"
            app:layout_constraintEnd_toStartOf="@+id/tv_key6"
            app:layout_constraintStart_toEndOf="@+id/tv_key4"
            app:layout_constraintTop_toBottomOf="@+id/tv_key2"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key6"
            android:text="6"
            app:layout_constraintBottom_toTopOf="@+id/tv_key9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_key5"
            app:layout_constraintTop_toBottomOf="@+id/tv_key3"
            style="@style/unlock_dialog"/>
        <View
            android:background="@color/cut_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toTopOf="@+id/tv_key7"
            app:layout_constraintTop_toBottomOf="@+id/tv_key4"/>
        <TextView
            android:id="@+id/tv_key7"
            android:text="7"
            app:layout_constraintBottom_toTopOf="@+id/iv_temp"
            app:layout_constraintEnd_toStartOf="@+id/tv_key8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_key4"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key8"
            android:text="8"
            app:layout_constraintBottom_toTopOf="@+id/tv_key0"
            app:layout_constraintEnd_toStartOf="@+id/tv_key9"
            app:layout_constraintStart_toEndOf="@+id/tv_key7"
            app:layout_constraintTop_toBottomOf="@+id/tv_key5"
            style="@style/unlock_dialog"/>
        <TextView
            android:id="@+id/tv_key9"
            android:text="9"
            app:layout_constraintBottom_toTopOf="@+id/iv_clear_pwd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_key8"
            app:layout_constraintTop_toBottomOf="@+id/tv_key6"
            style="@style/unlock_dialog"/>
        <ImageView
            android:id="@+id/iv_temp"
            android:visibility="invisible"
            android:src="@drawable/selector_btn_unlock2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_key0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_key7"
            style="@style/unlock_dialog"/>
        <View
            android:background="@color/cut_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toTopOf="@+id/iv_temp"
            app:layout_constraintTop_toBottomOf="@+id/tv_key7"/>
        <TextView
            android:id="@+id/tv_key0"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_clear_pwd"
            app:layout_constraintStart_toEndOf="@+id/iv_temp"
            app:layout_constraintTop_toBottomOf="@+id/tv_key8"
            style="@style/unlock_dialog"/>
        <ImageView
            android:id="@+id/iv_clear_pwd"
            android:src="@drawable/selector_input_delete_grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_key0"
            app:layout_constraintTop_toBottomOf="@+id/tv_key9"
            style="@style/unlock_dialog"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_unlock"
        android:padding="@dimen/padding_small"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/selector_btn_unlock1"/>
</LinearLayout>
