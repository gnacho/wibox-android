<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <androidx.gridlayout.widget.GridLayout
        android:padding="20dp"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="2"
        app:orientation="horizontal"
        app:useDefaultMargins="true">
        <TextView
            android:id="@+id/tv_name"
            android:text="@string/key_name"
            android:layout_marginEnd="20dp"
            style="@style/CustomTextView"/>
        <EditText
            android:id="@+id/et_device_name"
            android:background="@drawable/publico_shape_rectangle_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
        <TextView
            android:id="@+id/tv_uid"
            android:text="@string/key_uid"
            style="@style/CustomTextView"/>
        <EditText
            android:enabled="false"
            android:id="@+id/et_uid"
            android:background="@drawable/publico_shape_rectangle_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:singleLine="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
    </androidx.gridlayout.widget.GridLayout>
</LinearLayout>
