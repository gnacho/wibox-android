<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <TextView
        android:text="@string/key_enter_wifi_password_hint"
        style="@style/new_device_setup_title"/>
    <TextView
        android:textSize="@dimen/activity_device_config_wifi_textsize"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_wifi_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_normal"/>
    <FrameLayout
        android:layout_marginTop="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        style="@style/rlStyle">
        <EditText
            android:id="@+id/et_wifi_password"
            android:background="@color/white"
            android:layout_marginBottom="1dp"
            android:hint="@string/key_wifi_password"
            android:maxLength="64"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="5dp"
            style="@style/addEtStyle"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/iv_show_pwd"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_show_password_big"
            android:paddingStart="5dp"
            android:paddingEnd="10dp"/>
    </FrameLayout>
    <Button
        android:textSize="@dimen/text_normal_size"
        android:id="@+id/btn_next"
        android:background="@drawable/publico_selector_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="@dimen/standard_width"
        android:text="@string/key_next"/>
</LinearLayout>
