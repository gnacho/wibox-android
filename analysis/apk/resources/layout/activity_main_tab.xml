<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <EditText
        android:id="@+id/et_test"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tab_menu"
        android:background="@color/app_main_tab_bg"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_bottom_height">
        <TextView
            android:textSize="@dimen/bottom_text_size"
            android:textColor="@color/color_bottom_tab_text"
            android:gravity="center"
            android:id="@+id/main_iv_device"
            android:paddingTop="@dimen/table_btn_paddingTop"
            android:paddingBottom="@dimen/table_btn_paddingBottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:text="@string/key_device"
            android:drawableTop="@drawable/main_btn_device"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/bottom_text_size"
            android:textColor="@color/color_bottom_tab_text_normal"
            android:gravity="center"
            android:id="@+id/main_iv_callLog"
            android:paddingTop="@dimen/table_btn_paddingTop"
            android:paddingBottom="@dimen/table_btn_paddingBottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_call_logs"
            android:drawableTop="@drawable/main_btn_call_log"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/bottom_text_size"
            android:textColor="@color/color_bottom_tab_text_normal"
            android:gravity="center"
            android:id="@+id/main_iv_file"
            android:paddingTop="@dimen/table_btn_paddingTop"
            android:paddingBottom="@dimen/table_btn_paddingBottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_album"
            android:drawableTop="@drawable/main_btn_file"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/bottom_text_size"
            android:textColor="@color/color_bottom_tab_text_normal"
            android:gravity="center"
            android:id="@+id/main_iv_me"
            android:paddingTop="@dimen/table_btn_paddingTop"
            android:paddingBottom="@dimen/table_btn_paddingBottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_setting"
            android:drawableTop="@drawable/main_btn_setting"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
