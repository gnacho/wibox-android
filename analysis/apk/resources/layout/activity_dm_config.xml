<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_edit_info"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_device_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_device"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:layout_gravity="end"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_modify_password"
                android:text="@string/key_modify_device_password"
                style="@style/option_text_view"/>
            <TextView
                android:id="@+id/tv_modify_unlock_password"
                android:text="@string/key_modify_unlock_password"
                style="@style/option_text_view"/>
            <TextView
                android:id="@+id/tv_unlock_setting"
                android:text="@string/key_unlock_setting"
                style="@style/option_text_view"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_select_voice_model"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_intercom_way"
                    android:layout_weight="10"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <com.quvii.ubell.publico.util.MyMarqueeTextView
                    android:textSize="@dimen/text_normal_size"
                    android:textColor="@color/textColor"
                    android:gravity="center"
                    android:id="@+id/tv_voice_model"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    style="@style/Custom_Text_View_Marquee"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_fps"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_video_fps"
                    android:layout_weight="10"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <com.quvii.ubell.publico.util.MyMarqueeTextView
                    android:textSize="@dimen/text_normal_size"
                    android:textColor="@color/textColor"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_bit_str_cur"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_video_fps_high"
                    style="@style/Custom_Text_View_Marquee"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_select_lock_num"
                android:background="@drawable/publico_selector_btn_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_lock_number"
                    android:layout_weight="10"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center"
                    android:id="@+id/tv_lock_num"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="1"
                    android:textAlignment="center"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_config_wifi"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_wifi_setup"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_user"
                android:text="@string/key_user"
                style="@style/option_text_view"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_f1_time"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_f1_enable_time"
                    android:layout_weight="10"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:textColor="@color/textColor"
                    android:gravity="center"
                    android:id="@+id/tv_f1_enable_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="3"
                    android:layout_marginEnd="15dp"
                    style="@style/CustomTextView"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_ring_alert"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/key_alarm_call"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_alignParentStart="true"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:id="@+id/iv_ring_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/btn_switch_off"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="5dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_move_alert"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/key_alarm_motion"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_alignParentStart="true"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:id="@+id/iv_move_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/btn_switch_off"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="5dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_upgrade"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="@dimen/text_normal_size"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/key_firmware_version"
                    android:layout_weight="2"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:id="@+id/iv_upgrade_icon"
                    android:visibility="gone"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right_new"
                    android:layout_marginEnd="10dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_arrow_list_right"/>
            </LinearLayout>
            <Button
                android:textSize="@dimen/text_normal_size"
                android:gravity="center"
                android:id="@+id/bt_syn_time"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="15dp"
                android:text="@string/key_time_sync"/>
            <Button
                android:textSize="@dimen/text_normal_size"
                android:gravity="center"
                android:id="@+id/bt_del_device"
                android:background="@drawable/publico_selector_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/key_delete"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
