<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_background"
    android:background="@drawable/publico_selector_btn_bg"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <ImageView
            android:id="@+id/iv_status"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/device_status_online"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:textColor="@color/black_bg"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_device_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Device1"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/CustomTextView"/>
        <TextView
            android:textSize="@dimen/text_small_size"
            android:textColor="@color/textColorGray"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_device_info"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/key_share_cancel"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            style="@style/CustomTextView"/>
    </LinearLayout>
    <com.quvii.ubell.publico.view.MyImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/device_cover_default"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_setting"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_home"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_call_guard"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_call_guard"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_f1"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_device_f1"/>
        <View
            android:id="@+id/v_line_lock1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_lock1"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_device_lock1"/>
    </LinearLayout>
</LinearLayout>
