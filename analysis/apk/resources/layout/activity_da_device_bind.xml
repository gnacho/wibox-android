<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_background"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3"/>
    <TextView
        android:textSize="@dimen/text_normal_size"
        android:id="@+id/tv_hint"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/key_device_online_add_hint"
        style="@style/CustomTextView"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
    <androidx.gridlayout.widget.GridLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="3"
        app:orientation="horizontal"
        app:useDefaultMargins="true">
        <TextView
            android:id="@+id/tv_name"
            android:text="@string/key_name"
            style="@style/CustomTextView"/>
        <EditText
            android:id="@+id/et_device_name"
            android:background="@drawable/selector_shape_rectangle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
        <ImageView
            android:visibility="invisible"
            android:src="@drawable/qr_code_n"
            app:layout_gravity="center"/>
        <TextView
            android:id="@+id/tv_uid"
            android:text="@string/key_uid"
            style="@style/CustomTextView"/>
        <EditText
            android:id="@+id/et_uid"
            android:background="@drawable/selector_shape_rectangle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:singleLine="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
        <ImageView
            android:id="@+id/iv_qr"
            android:src="@drawable/qr_code_n"
            app:layout_gravity="center"/>
        <TextView
            android:id="@+id/tv_password"
            android:text="@string/key_pin_code"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            style="@style/CustomTextView"/>
        <EditText
            android:id="@+id/et_device_password"
            android:background="@drawable/selector_shape_rectangle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:singleLine="true"
            android:inputType="textPassword"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
        <ImageView
            android:id="@+id/iv_show_pwd"
            android:src="@drawable/btn_show_password_big"
            app:layout_gravity="center"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_share_link_input_hint"
            android:visibility="gone"
            android:layout_height="40dp"
            android:text="@string/key_input_share_link_hint"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            app:layout_columnSpan="3"
            style="@style/CustomTextView"/>
        <TextView
            android:id="@+id/tv_share_link"
            android:visibility="gone"
            android:text="@string/key_share_link"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            style="@style/CustomTextView"/>
        <EditText
            android:id="@+id/et_input_share_link"
            android:background="@drawable/selector_shape_rectangle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:singleLine="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:layout_columnWeight="1"
            style="@style/CustomEdit"/>
    </androidx.gridlayout.widget.GridLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:gravity="center"
        android:id="@+id/bt_confirm"
        android:layout_marginTop="10dp"
        android:text="@string/key_save"
        style="@style/option_button"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
