<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <com.quvii.ubell.publico.widget.playwindow.PagedDragDropGrid
        android:id="@+id/grid"
        android:background="@color/preview_item_bg"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_below="@+id/publico_titlebar"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_alignTop="@+id/grid"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:id="@+id/ll_recording_time"
            android:background="@drawable/bg_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_tip_recording"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="5dp"/>
            <Chronometer
                android:textSize="@dimen/talk_record_text_size"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/ch_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format="%s"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_preview_time"
            android:background="@drawable/bg_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp">
            <TextView
                android:textSize="@dimen/talk_record_text_size"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_preview_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format="%s"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_middle"
        android:background="@color/icon_black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/grid">
        <ImageView
            android:id="@+id/iv_play"
            android:visibility="gone"
            android:src="@drawable/vertical_preview_play_selector"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:id="@+id/iv_talk"
            android:visibility="gone"
            android:src="@drawable/selector_preview_talk"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:id="@+id/iv_talk_cut_line"
            android:visibility="gone"
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_voice"
            android:visibility="gone"
            android:src="@drawable/vertical_preview_mute_selector"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:visibility="gone"
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_record"
            android:src="@drawable/vertical_preview_video_recording_selector"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_snapshot"
            android:src="@drawable/vertical_screenshot_selector"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_channel"
            android:src="@drawable/selector_channel_switch"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:id="@+id/iv_channel_cut_line"
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_video_fps"
            android:src="@drawable/btn_preview_mode_normal"
            style="@style/PreviewMiddleButton"/>
        <ImageView
            android:id="@+id/iv_f1_cut_line"
            android:src="@drawable/icon_cut_line"
            style="@style/PreviewMiddleCutLine"/>
        <ImageView
            android:id="@+id/iv_f1"
            android:src="@drawable/selector_preview_f1"
            style="@style/PreviewMiddleButton"/>
    </LinearLayout>
    <com.quvii.ubell.video.widget.CustomLayout
        android:id="@+id/custom_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_middle">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_operator_layout"
                android:background="@color/main_ui_color_white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_unlock"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/play_unlock_selector"/>
                <View
                    android:id="@+id/v_unlock_middle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_refuse"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/selector_refuse"/>
                <View
                    android:id="@+id/v_talk_middle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_accept"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/selector_accept"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_debug_info"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.quvii.ubell.video.widget.PreviewVerticalUnlockLayout
            android:id="@+id/pvUnlock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.quvii.ubell.video.widget.CustomLayout>
    <include
        android:id="@+id/full"
        android:visibility="gone"
        layout="@layout/multi_full_screen_operate_bar"/>
</RelativeLayout>
