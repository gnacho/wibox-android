<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/logo"/>
    <requestFocus/>
    <TextView
        android:textSize="25sp"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_app_name"
        android:paddingBottom="3dp"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="@string/app_name"/>
    <TextView
        android:textSize="15sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_version_about"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="version about"/>
    <Button
        android:textSize="@dimen/text_normal_size"
        android:layout_gravity="center"
        android:id="@+id/bt_privacy_policy"
        android:background="@drawable/publico_selector_btn_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/standard_width"
        android:layout_marginTop="@dimen/standard_width"
        android:layout_marginRight="@dimen/standard_width"
        android:text="@string/key_privacy_policy"
        android:layout_marginStart="@dimen/standard_width"
        android:layout_marginEnd="@dimen/standard_width"/>
</LinearLayout>
