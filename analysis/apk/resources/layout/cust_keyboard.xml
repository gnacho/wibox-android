<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_scroll_to_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/selector_scroll_to_right"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <LinearLayout
                android:gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_unlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="20dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/iv_show_pwd"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/btn_show_password"/>
                <TextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/tv_show_pwd"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:maxLength="16"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    style="@style/CustomTextView"/>
                <ImageView
                    android:id="@+id/iv_clear_pwd"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/selector_delete_one"/>
            </LinearLayout>
            <View
                android:id="@+id/iv_under_show_pwd"
                android:background="@drawable/line_preview_password"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_unlock"/>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/ll_unlock_input1"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintHeight_percent="0.2"
                app:layout_constraintTop_toBottomOf="@+id/iv_under_show_pwd">
                <ImageView
                    android:id="@+id/iv_key1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn2"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn3"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn4"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn5"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_unlock_input2"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/iv_key6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn6"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn7"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn8"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn9"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_key0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/selector_btn0"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_unlock_input3"
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/tv_unlock1"
                    android:layout_width="120dp"
                    android:layout_height="85dp"
                    android:drawableTop="@drawable/selector_btn_unlock1"
                    android:textAlignment="center"
                    style="@style/CustomTextView"/>
                <View
                    android:id="@+id/v_middle"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/tv_unlock2"
                    android:layout_width="120dp"
                    android:layout_height="85dp"
                    android:drawableTop="@drawable/selector_btn_unlock2"
                    android:textAlignment="center"
                    style="@style/CustomTextView"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
