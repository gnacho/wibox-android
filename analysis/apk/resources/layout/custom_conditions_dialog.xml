<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="60dp"
    android:layout_marginBottom="60dp"
    android:layout_centerHorizontal="true"
    android:layout_centerVertical="true">
    <TextView
        android:textSize="@dimen/text_normal_size"
        android:textStyle="bold"
        android:textColor="@color/appTitleColor"
        android:gravity="center"
        android:padding="@dimen/margin_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_normal"
        android:text="@string/key_agree_view_title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/textColor"
                android:layout_gravity="center"
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="12dp"
                android:text="This is message"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_confirm_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginRight="@dimen/margin_normal"
                android:layout_marginBottom="@dimen/margin_small">
                <CheckBox
                    android:id="@+id/cb_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.6"
                    android:scaleY="0.6"/>
                <TextView
                    android:textColor="@color/textColor"
                    android:id="@+id/tv_confirm_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/co_consent_info"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:background="#e4e4e4"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/no"
            android:background="@color/bg_red"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_disagree"
            android:maxLines="1"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/yes"
            android:background="@android:color/darker_gray"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/key_agree"
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
