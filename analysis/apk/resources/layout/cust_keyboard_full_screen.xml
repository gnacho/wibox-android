<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_background"
    android:background="#293138"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.5">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#07aef7"
            android:gravity="center"
            android:id="@+id/tv_show_pwd_full"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/iv_clear_full"
            android:layout_toEndOf="@+id/iv_show_pwd_full"/>
        <ImageView
            android:id="@+id/iv_under_show_pwd"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/bg_listdividingline"
            android:layout_below="@+id/tv_show_pwd_full"/>
        <ImageView
            android:id="@+id/iv_show_pwd_full"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/btn_show_password"
            android:layout_above="@+id/iv_under_show_pwd"
            android:layout_alignLeft="@+id/iv_under_show_pwd"/>
        <ImageView
            android:id="@+id/iv_clear_full"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/selector_delete_one"
            android:layout_alignTop="@+id/tv_show_pwd_full"
            android:layout_alignRight="@+id/iv_under_show_pwd"/>
    </RelativeLayout>
    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:columnCount="3"
        app:orientation="horizontal">
        <ImageView
            android:id="@+id/key7_full"
            android:src="@drawable/selector_btn7_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key8_full"
            android:src="@drawable/selector_btn8_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key9_full"
            android:src="@drawable/selector_btn9_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key4_full"
            android:src="@drawable/selector_btn4_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key5_full"
            android:src="@drawable/selector_btn5_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key6_full"
            android:src="@drawable/selector_btn6_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key1_full"
            android:src="@drawable/selector_btn1_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key2_full"
            android:src="@drawable/selector_btn2_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key3_full"
            android:src="@drawable/selector_btn3_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/key0_full"
            android:src="@drawable/selector_btn0_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/bt_go_1_full"
            android:src="@drawable/selector_bt_go_1_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
        <ImageView
            android:id="@+id/bt_go_2_full"
            android:src="@drawable/selector_bt_go_2_full_screen"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            style="@style/CustomLockButton"/>
    </androidx.gridlayout.widget.GridLayout>
</LinearLayout>
