<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="35sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:text="1"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_handle_wifi_hint1"/>
    </LinearLayout>
    <View
        android:background="@color/new_line_color"
        android:layout_width="match_parent"
        android:layout_height="3dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="35sp"
            android:textStyle="bold"
            android:id="@+id/tvSetupTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_large"
            android:text="2"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/lvSetupTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:src="@drawable/prompt_setup_wifi"
            android:layout_toEndOf="@+id/tvSetupTwo"/>
        <TextView
            android:textSize="@dimen/text_normal_size"
            android:id="@+id/tv_hint_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/key_switch_wifi_hint"
            android:layout_below="@+id/lvSetupTwo"
            android:textAlignment="textStart"
            android:layout_toEndOf="@+id/tvSetupTwo"
            android:layout_alignEnd="@+id/lvSetupTwo"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/tv_hint_name"
            android:layout_toEndOf="@+id/tvSetupTwo"
            android:layout_alignEnd="@+id/lvSetupTwo">
            <TextView
                android:textSize="@dimen/text_normal_size"
                android:id="@+id/tv_hint_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/key_password"
                android:layout_weight="1"
                android:textAlignment="textStart"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_copy"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <Button
        android:textSize="@dimen/text_normal_size"
        android:id="@+id/bt_next"
        android:background="@drawable/publico_selector_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:text="@string/key_next"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
