<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_title"
        android:background="@color/clr_normal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_small">
        <RadioButton
            android:textColor="@color/fm_fragment_text_selected"
            android:gravity="center"
            android:id="@+id/rb_all_activity"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_alarm_title_all"
            android:layout_weight="1"/>
        <RadioButton
            android:textColor="@color/fm_fragment_text_normal"
            android:gravity="center"
            android:id="@+id/rb_rings"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_alarm_title_call"
            android:layout_weight="1"/>
        <RadioButton
            android:textColor="@color/fm_fragment_text_normal"
            android:gravity="center"
            android:id="@+id/rb_motion"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/key_alarm_title_motion"
            android:layout_weight="1"/>
    </RadioGroup>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_line_all_activity_rings_motion"
        android:background="@color/clr_normal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fm_fragment_dial_info_line">
        <ImageView
            android:id="@+id/line_all_activity"
            android:background="@color/fm_fragment_text_selected"
            android:layout_width="0dp"
            android:layout_height="@dimen/fm_fragment_dial_info_line"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/line_rings"
            android:layout_width="0dp"
            android:layout_height="@dimen/fm_fragment_dial_info_line"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/line_motion"
            android:layout_width="0dp"
            android:layout_height="@dimen/fm_fragment_dial_info_line"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_dividing_line"
        android:background="@color/main_ui_color_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fm_fragment_dial_info_line"/>
    <com.booking.rtlviewpager.RtlViewPager
        android:id="@+id/vp_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_bottom"
        android:background="@color/colorPrimary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_bottom_height">
        <ImageView
            android:id="@+id/iv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/selector_file_all_selected"
            android:scaleType="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/selector_file_delete"
            android:scaleType="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>
</LinearLayout>
