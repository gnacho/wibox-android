<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/textColor"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_no_record"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/standard_width"
        android:text="@string/key_album_empty_hint"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/standard_width"
        android:layout_marginEnd="@dimen/standard_width"/>
    <com.quvii.ubell.publico.widget.stickygridheaders.StickyGridHeadersGridView
        android:id="@+id/file_grid"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:horizontalSpacing="3dp"
        android:verticalSpacing="3dp"
        android:columnWidth="90dp"
        android:numColumns="auto_fit"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_edit_info"
        android:background="@color/colorPrimary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <ImageView
            android:id="@+id/iv_all_select_file"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_file_all_selected"
            android:layout_marginStart="5dp"/>
        <View
            android:id="@+id/v_cut_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_file_save"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_btn_save"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_file_share"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_share"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_file_delete"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/selector_file_delete"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
</LinearLayout>
