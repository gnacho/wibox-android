<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_ui_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/publico_titlebar"
        layout="@layout/publico_include_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_unlock_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_quick_unlock"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="@dimen/text_normal_size"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_quick_unlock"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_alignParentStart="true"
                style="@style/CustomTextView"/>
            <ImageView
                android:id="@+id/iv_quick_unlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_switch_off"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_biological_unlock"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="@dimen/text_normal_size"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_biological_unlock"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_alignParentStart="true"
                style="@style/CustomTextView"/>
            <ImageView
                android:id="@+id/iv_biological_unlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_switch_off"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
